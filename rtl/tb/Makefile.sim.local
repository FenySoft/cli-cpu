# hu: Sub-make Makefile — a Makefile.sim include-ot itt végzi, ahol a PATH
#     már a venv bin-jét tartalmazza (a parent Makefile target ezt
#     gondoskodik). A parent Makefile NEM include-olja a Makefile.sim-et,
#     hogy elkerüljük a `cocotb-config` parent shell-en hiányát.
# en: Sub-make Makefile — does the Makefile.sim include here, where PATH
#     already contains the venv bin (arranged by the parent Makefile target).
#     The parent Makefile does NOT include Makefile.sim, to avoid the missing
#     `cocotb-config` in the parent shell.

SIM ?= verilator
TOPLEVEL_LANG ?= verilog
EXTRA_ARGS += --trace -I$(PWD)/../src

# hu: Wrapper paraméterek átadása a Verilator-nak (-G<param>=<value>).
#     A target Makefile-ban beállított LOCAL_COMPILE_ARGS itt csatolódik
#     a cocotb által rakott COMPILE_ARGS-ra (a make command-line override
#     elkerülése végett nem közvetlenül a COMPILE_ARGS-ba töltjük).
# en: Forward wrapper parameters to Verilator (-G<param>=<value>).
#     Target Makefile sets LOCAL_COMPILE_ARGS, appended here to cocotb's
#     COMPILE_ARGS (avoids the make command-line override pitfall).
COMPILE_ARGS += $(LOCAL_COMPILE_ARGS)

VENV_PY     ?= /usr/local/bin/python3.13
VENV_SITE   ?= $(PWD)/../.venv/lib/python3.13/site-packages
COCOTB_MAKEFILES ?= $(shell PYTHONPATH="$(VENV_SITE)" $(VENV_PY) -c \
	"from cocotb_tools.config import main; import sys; sys.argv=['c','--makefiles']; main()" 2>/dev/null \
	|| echo "$(VENV_SITE)/cocotb_tools/makefiles")

export PYTHONPATH := $(VENV_SITE)

include $(COCOTB_MAKEFILES)/Makefile.sim
